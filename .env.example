# ─────────────────────────────────────────────────────────────────────────────
# MarketMind AI – Environment Configuration
# 1. Copy this file:   cp .env.example .env      (Linux / Mac)
#                      copy .env.example .env     (Windows)
# 2. Fill in your values below
# 3. NEVER commit .env to version control – it contains secrets
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose ONE: "claude" (best quality) | "gemini" (free tier) | "openai" (paid)
LLM_PROVIDER=claude

# ── Anthropic / Claude (recommended) ─────────────────────────────────────────
# Get key: https://console.anthropic.com/
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-opus-4-5

# ── Gemini (Google AI Studio – free tier available) ───────────────────────────
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ── OpenAI (optional) ─────────────────────────────────────────────────────────
# Get key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Email / SMTP (for alerts and subscription confirmations) ──────────────────
# Gmail setup:
#   1. Enable 2-Factor Authentication on your Google account
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail"
#   4. Use that 16-character password as SMTP_PASSWORD
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16char_app_password_here
# Optional overrides (defaults work for Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# ── Flask Dashboard ───────────────────────────────────────────────────────────
FLASK_PORT=5050
# Generate a strong key:  python3 -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: Without this, login sessions reset on every server restart
FLASK_SECRET_KEY=change_me_to_a_long_random_string_minimum_32_chars

# ── Telegram Alerts (optional) ────────────────────────────────────────────────
# Create a bot: https://t.me/botfather  → /newbot  → copy the token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Leave blank for localhost (polling mode). Set for production with a public domain:
# TELEGRAM_WEBHOOK_URL=https://yourdomain.com

# ── Market Data Fallback (optional) ──────────────────────────────────────────
# Alpha Vantage free tier: 25 requests/day — get a free key at:
# https://www.alphavantage.co/support/#api-key
# Leave empty to skip this fallback (Yahoo Finance is tried first).
ALPHA_VANTAGE_KEY=
