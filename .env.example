# MarketMind AI – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Required for AI Analysis Agent
# OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Gemini (Google) ───────────────────────────────────────────────────────────
# Get key from: https://aistudio.google.com/app/apikey  (free tier available)
# Uses new google-genai SDK
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ── Optional provider switch (gemini or openai) ───────────────────────────────
LLM_PROVIDER=gemini

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# ── Flask Dashboard ───────────────────────────────────────────────────────────
FLASK_PORT=5050
FLASK_SECRET_KEY=change_me_to_a_long_random_string

# ── Optional overrides ────────────────────────────────────────────────────────
# OPENAI_MODEL=gpt-4o-mini
# LOG_LEVEL=INFO
