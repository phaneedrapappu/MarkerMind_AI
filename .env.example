# MarketMind AI Environment Variables

# OpenAI API Key (required for AI Analysis Agent)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Override GPT model
# OPENAI_MODEL=gpt-4o-mini

# Optional: Set log level
# LOG_LEVEL=INFO

# Optional: Database connection (for future use)
# DATABASE_URL=postgresql://user:password@localhost/marketmind

# Optional: Twilio credentials (for WhatsApp notifications - future)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
